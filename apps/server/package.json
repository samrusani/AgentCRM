{
  "name": "@agentcrm/server",
  "version": "0.1.0",
  "private": true,
  "description": "AgentCRM API server, job worker, CLI, and MCP server",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "crm": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "seed": "tsx src/cli.ts seed",
    "doctor": "tsx src/cli.ts doctor",
    "mcp": "tsx src/cli.ts mcp",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.3",
    "fastify": "^5.12.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
